# Copy to .env and adjust. Values below are safe placeholders for local dev only —
# never reuse them anywhere real.

NODE_ENV=development
PORT=3000

# Must match the Postgres container started by the root docker-compose.yml
# (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB from the root .env).
DATABASE_URL=postgresql://hairapp:hairapp@localhost:5432/hairapp

# Any long random string works for local dev. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-000000000000
JWT_REFRESH_SECRET=dev-only-change-me-refresh-00000000000
STORAGE_SIGNING_SECRET=dev-only-change-me-storage-00000000000

# Where uploaded photos are stored on disk in local dev.
STORAGE_DIR=./storage
# How long a signed image URL stays valid.
STORAGE_URL_TTL_SECONDS=300

# Claude API — required starting at Milestone 4 (AI integration). Leave blank until then.
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

RATE_LIMIT_FREE_ANALYSES_PER_DAY=5
